<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hello World!</title>
  <style>
    body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(135deg, #0f172a, #1e1b4b); font-family: system-ui, sans-serif; color: white; overflow: hidden; text-align: center; }
    h1 { font-size: 3.5rem; transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); user-select: none; text-shadow: 0 10px 20px rgba(0,0,0,0.5); margin-bottom: 20px; }
    button { padding: 14px 28px; font-size: 1.2rem; font-weight: bold; color: white; background: linear-gradient(135deg, #6366f1, #a855f7); border: none; border-radius: 50px; cursor: pointer; box-shadow: 0 4px 15px rgba(168, 85, 247, 0.4); transition: transform 0.2s, box-shadow 0.2s; outline: none; }
    button:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(168, 85, 247, 0.6); }
    button:active { transform: translateY(1px); }
    .particle { position: absolute; pointer-events: none; border-radius: 50%; animation: floatUp 1s ease-out forwards; }
    @keyframes floatUp { 0% { opacity: 1; transform: translate(-50%, -50%) scale(1); } 100% { opacity: 0; transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0); } }
  </style>
</head>
<body>
  <h1 id="heading">Hello World! 👋</h1>
  <button onclick="bounceAndPop(event)">Click for Magic ✨</button>

  <script>
    let isMoved = false;
    function bounceAndPop(e) {
      const heading = document.getElementById('heading');
      heading.style.transform = isMoved ? 'translate(0, 0) rotate(0deg) scale(1)' : `translate(${(Math.random()-0.5)*120}px, ${(Math.random()-0.5)*60}px) rotate(${(Math.random()-0.5)*30}deg) scale(1.2)`;
      isMoved = !isMoved;
      for (let i = 0; i < 20; i++) {
        const p = document.createElement('div');
        p.className = 'particle';
        p.style.left = e.clientX + 'px'; p.style.top = e.clientY + 'px';
        const sz = Math.random() * 12 + 6;
        p.style.width = sz + 'px'; p.style.height = sz + 'px';
        p.style.background = `hsl(${Math.random() * 360}, 80%, 60%)`;
        p.style.setProperty('--dx', (Math.random() - 0.5) * 200 + 'px');
        p.style.setProperty('--dy', (Math.random() - 0.5) * 200 + 'px');
        document.body.appendChild(p);
        setTimeout(() => p.remove(), 1000);
      }
    }
  </script>
</body>
</html>
